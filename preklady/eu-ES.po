#: index
msgid "Swajp – Anax Keyboard"
msgstr "Swajp – Anax teklatua"

#: index
msgid "A keyboard<br><em>fit for an emperor.</em>"
msgstr "Teklatu bat<br><em>enperadore baten mailakoa.</em>"

#: index
msgid "Swift as Anax – the emperor dragonfly.<br>Precise as its hunt."
msgstr ""
"Anax bezain azkarra – burruntzi enperadore handia.<br>Bere ehiza bezain zehatza."

#: index
msgid ""
"<strong class=\"story\">Inspired by Swype. Born as Swajp.</strong> An Android keyboard you type on with a glide of your finger. It guesses words from context, learns your style, and all your data stays on your phone."
msgstr ""
"<strong class=\"story\">Swype-n inspiratua. Swajp gisa jaioa.</strong> Hatza irristatuz idazteko Android teklatua. Hitzak testuinguruaren arabera asmatzen ditu, zure estiloa ikasten du, eta zure datu guztiak telefonoan geratzen dira."

#: index
msgid "Get it on Google Play"
msgstr "Eskuratu Google Play-n"

#: index languages
msgid "Language packs"
msgstr "Hizkuntza-paketeak"

#: index
msgid "Features"
msgstr "Eginbideak"

#: index
msgid "Swipe typing"
msgstr "Irristatze bidezko idazketa"

#: index
msgid "Glide over the letters and the word appears."
msgstr "Irristatu letren gainetik, eta hitza agertuko da."

#: index
msgid "Word prediction"
msgstr "Hitzen iragarpena"

#: index
msgid "Suggests the next word from what you type."
msgstr "Idazten duzunaren arabera, hurrengo hitza iradokitzen du."

#: index
msgid "Gestures & text editing"
msgstr "Keinuak eta testu-edizioa"

#: index
msgid "Copy, paste, undo and select with one swipe."
msgstr "Kopiatu, itsatsi, desegin eta hautatu irristatze bakar batez."

#: index
msgid "Themes &amp; colours"
msgstr "Gaiak eta koloreak"

#: index
msgid "Six themes or colours of your own."
msgstr "Sei gai edo zure koloreak."

#: index
msgid "Size &amp; layout"
msgstr "Tamaina eta diseinua"

#: index
msgid "Split, one-handed or floating."
msgstr "Zatitua, esku bakarrekoa edo flotatzailea."

#: index
msgid "Number pad & calculator"
msgstr "Zenbaki-teklatua eta kalkulagailua"

#: index
msgid "Big digits, a calculator and a scientific one."
msgstr "Zenbaki handiak, kalkulagailua eta kalkulagailu zientifikoa."

#: index
msgid "Emoji"
msgstr "Emojiak"

#: index
msgid "Type a word and the emoji flies in."
msgstr "Idatzi hitz bat, eta emojia hegan iritsiko da."

#: index
msgid "Two languages at once, 35 in total."
msgstr "Bi hizkuntza aldi berean, 35 guztira."

#: index
msgid "Offline dictation"
msgstr "Lineaz kanpoko diktatzea"

#: index
msgid "Speech to text right on your phone."
msgstr "Ahotsetik testura, zuzenean zure telefonoan."

#: index
msgid "Clipboard history"
msgstr "Arbelaren historia"

#: index
msgid "Your last 30 copied texts at hand."
msgstr "Kopiatutako azken 30 testuak eskura."

#: index
msgid "Backup"
msgstr "Babeskopia"

#: index
msgid "Take your learned words to your new phone."
msgstr "Eraman ikasitako hitzak zure telefono berrira."

#: index
msgid "No internet, no ads, no tracking."
msgstr "Internetik gabe, iragarkirik gabe, jarraipenik gabe."

#: index (atribut / attribute)
