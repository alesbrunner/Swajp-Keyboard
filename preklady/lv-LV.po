msgstr "Kopē, ielīmē, atsauc un atlasi ar vienu vilkumu."

#: index
msgid "Themes &amp; colours"
msgstr "Motīvi un krāsas"

#: index
msgid "Six themes or colours of your own."
msgstr "Seši motīvi vai paša izvēlētas krāsas."

#: index
msgid "Size &amp; layout"
msgstr "Izmērs un izkārtojums"

#: index
msgid "Split, one-handed or floating."
msgstr "Sadalīta, vienai rokai vai peldoša."

#: index
msgid "Number pad & calculator"
msgstr "Ciparu tastatūra un kalkulators"

#: index
msgid "Big digits, a calculator and a scientific one."
msgstr "Lieli cipari, kalkulators un arī zinātniskais."

#: index
msgid "Emoji"
msgstr "Emocijzīmes"

#: index
msgid "Type a word and the emoji flies in."
msgstr "Uzraksti vārdu, un emocijzīme atlido."

#: index
msgid "Two languages at once, 35 in total."
msgstr "Divas valodas vienlaikus, kopā 35."

#: index
