msgid "Features"
msgstr "Ko tā prot"

#: index
msgid "Swipe typing"
msgstr "Rakstīšana ar vilkšanu"

#: index
msgid "Glide over the letters and the word appears."
msgstr "Slīdi pār burtiem, un vārds parādās pats."

#: index
msgid "Word prediction"
msgstr "Vārdu paredzēšana"

#: index
msgid "Suggests the next word from what you type."
