msgid "Swajp – licenses and credits"
msgstr "Swajp – litsentsid ja autorid"

#: licenses
msgid "Licenses and credits"
msgstr "Litsentsid ja autorid"

#: licenses
msgid "Swajp uses the following data and libraries. Thanks to their authors."
msgstr "Swajp kasutab järgmisi andmeid ja teeke. Täname nende autoreid."

