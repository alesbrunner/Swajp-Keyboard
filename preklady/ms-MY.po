msgstr "Pertuturan kepada teks terus dalam telefon anda."

#: index
msgid "Clipboard history"
msgstr "Sejarah papan klip"

#: index
msgid "Your last 30 copied texts at hand."
msgstr "30 teks terakhir yang anda salin sentiasa di hujung jari."

#: index
msgid "Backup"
msgstr "Sandaran"

#: index
msgid "Take your learned words to your new phone."
msgstr "Bawa perkataan yang dipelajari ke telefon baharu anda."

#: index
msgid "No internet, no ads, no tracking."
msgstr "Tanpa internet, tanpa iklan, tanpa penjejakan."

#: index (atribut / attribute)
