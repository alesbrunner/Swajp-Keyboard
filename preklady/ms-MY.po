msgid "Language packs"
msgstr "Pakej bahasa"

#: index
msgid "Features"
msgstr "Ciri-ciri"

#: index
msgid "Swipe typing"
msgstr "Taipan leret"

#: index
msgid "Glide over the letters and the word appears."
msgstr "Leret di atas huruf dan perkataan pun muncul."

#: index
msgid "Word prediction"
msgstr "Ramalan perkataan"

#: index
msgid "Suggests the next word from what you type."
msgstr "Mencadangkan perkataan seterusnya berdasarkan apa yang anda taip."

#: index
msgid "Gestures & text editing"
msgstr "Gerak isyarat & suntingan teks"

#: index
msgid "Copy, paste, undo and select with one swipe."
msgstr "Salin, tampal, buat asal dan pilih dengan satu leretan."

#: index
msgid "Themes &amp; colours"
msgstr "Tema &amp; warna"

#: index
msgid "Six themes or colours of your own."
msgstr "Enam tema atau warna pilihan anda sendiri."

#: index
msgid "Size &amp; layout"
msgstr "Saiz &amp; susun atur"

#: index
msgid "Split, one-handed or floating."
msgstr "Terbelah, sebelah tangan atau terapung."

#: index
msgid "Number pad & calculator"
msgstr "Pad nombor & kalkulator"

#: index
msgid "Big digits, a calculator and a scientific one."
msgstr "Digit besar, kalkulator dan kalkulator saintifik."

#: index
msgid "Emoji"
msgstr "Emoji"

#: index
msgid "Type a word and the emoji flies in."
msgstr "Taip perkataan dan emoji pun terbang masuk."

#: index
msgid "Two languages at once, 35 in total."
msgstr "Dua bahasa serentak, 35 kesemuanya."

#: index
msgid "Offline dictation"
msgstr "Imlak luar talian"

#: index
